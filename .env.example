# InternDesk — Multi-Tenant Enterprise Environment Variables (Production & Staging)
# Strictly Zero Payment Gateways • Zero Course Fees

# ==========================================
# 1. Supabase & PostgreSQL Multi-Tenant DB
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is used STRICTLY on the server / background migrations. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...secret-service-role-key-here

# ==========================================
# 2. Transactional Email Provider (Resend / SMTP)
# ==========================================
# Used for verification OTPs, invitation tokens, and document issuance notifications
RESEND_API_KEY=re_your_api_key_here
EMAIL_PROVIDER_API_KEY=re_your_api_key_here
EMAIL_FROM=InternDesk <no-reply@yourdomain.com>

# ==========================================
# 3. Application Base URL & Domain Config
# ==========================================
NEXT_PUBLIC_APP_URL=https://interndesk.yourdomain.com
NEXT_PUBLIC_APP_NAME=InternDesk

# ==========================================
# 4. Multi-Tenant Governance & Environment
# ==========================================
# Set to 'production' in deployed clusters to enforce strict Supabase RLS and disable demo persona toggle
NEXT_PUBLIC_APP_ENV=production
# Super Admin email for initial bootstrap access
PLATFORM_SUPER_ADMIN_EMAIL=superadmin@interndesk.enterprise
