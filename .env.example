# InternDesk — Single Institute Edition Environment Variables
# Institute: Akash Technolabs Private Limited
# Strictly Zero Payment Gateways • Zero Course Fees • 100% Free

# ==========================================
# 1. Central Institute Identity & Governance
# ==========================================
INSTITUTE_NAME="Akash Technolabs"
ALLOWED_INSTITUTE_EMAIL_DOMAINS="akashtechnolabs.com,student.akashtechnolabs.com,gmail.com"
PRIMARY_ADMIN_EMAIL="akash@akashtechnolabs.com"
NEXT_PUBLIC_APP_NAME="Akash Technolabs — Student Activity & Practicum Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# 2. Supabase PostgreSQL & Auth Configuration
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is used STRICTLY on the server / background migrations. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...secret-service-role-key-here

# ==========================================
# 3. Transactional Email Providers
# ==========================================
# METHOD A: Gmail SMTP (Sends to ALL users / ANY email address with 0 restrictions)
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Akash Technolabs <your-email@gmail.com>"

# METHOD B: EmailJS (Sends directly to ANY user email worldwide without domain restrictions)
EMAILJS_SERVICE_ID=service_yjkjz93
EMAILJS_TEMPLATE_ID=template_uyp4nwp
EMAILJS_PUBLIC_KEY=zIi0geqydH-23S8nQ
EMAILJS_PRIVATE_KEY=0kcv6IqmCERtCGGfGM0lK

# METHOD C: Resend REST API
# Note: To send to all external recipients without sandbox restrictions,
# verify your custom domain at https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Akash Technolabs <onboarding@resend.dev>"
